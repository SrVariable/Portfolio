---
import SectionTitle from "../components/SectionTitle.astro"
import { EDUCATIONS } from "../const/education.ts"
---

<section id="education" class="mx-auto mb-24 w-full max-w-4xl scroll-mt-24 px-4 md:mb-48">
  <SectionTitle>📖 Educación 📖</SectionTitle>
  <div class="flex flex-col gap-4">
    {
      EDUCATIONS.map(({ title, source, duration, description }) => (
        <article class="rounded-xl border border-line bg-surface/40 p-6 transition-colors duration-200 hover:border-line-strong hover:bg-surface">
          <h3 class="text-lg font-semibold text-accent">{title}</h3>
          <p class="mt-1 text-sm text-fg">{source}</p>
          <p class="mt-1 text-xs tracking-widest text-fg-subtle uppercase">{duration}</p>
          <p class="mt-4 leading-relaxed text-fg-muted text-pretty">{description}</p>
        </article>
      ))
    }
  </div>
</section>
