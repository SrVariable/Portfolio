---
import GitHub from "../components/GitHub.astro";
import LinkedIn from "../components/LinkedIn.astro";
import Email from "../components/Email.astro";
---

<section id="hero" class="flex flex-col md:flex-row
                          justify-center items-center
                          min-h-120 w-full px-4 my-25 mb-10
                          text-white
                          scroll-mt-20">
  <img
    src="/images/chopper.webp"
    alt="An image of Chopper sitting in V logo"
    class="self-center rounded-full
            mb-2 size-30
            border-3 border-theme-white
            md:rounded-full md:size-44"
  />
  <div class="flex flex-col items-center">
    <h1 class="text-3xl sm:text-4xl mb-4 font-bold text-center">
      Yow, soy <strong class="text-theme-yellow">SrVariable</strong> 👋
    </h1>
    <h2 class="text-lg text-center text-theme-white text-shadow-lg
              px-4 mb-4 italic font-bold 
              bg-linear-to-r from-primary-shade-2 to-primary-shade inset-shadow-black inset-shadow-md">
      Sé más de lo que creo y menos de lo que piensas
    </h2>
    <div class="flex flex-col">
      <p class="text-lg text-center mb-4 max-w-xl sm:pl-8">
        +3 años de experiencia. <strong class="text-theme-yellow">Desarrollador de Software</strong> de Málaga, España.
        Especializado en <strong class="text-theme-yellow">resolver problemas</strong> y buscando mi siguiente reto.
      </p>
    </div>
    <nav class="w-full xsm:w-120">
      <ul class="grid grid-cols-2 xsm:grid-cols-3 gap-4">
        <li class="rounded-2xl p-2 
                    bg-linear-to-tl from-primary-shade-2 to-primary-shade
                    inset-shadow-none hover:inset-shadow-sm hover:inset-shadow-black
                    hover:text-shadow-white hover:text-shadow-sm">
          <a
            href="https://github.com/SrVariable"
            target="_blank"
            rel="noopener noreferrer"
            class="flex justify-center gap-2 text-theme-white"
          >
            <GitHub />
            GitHub
          </a>
        </li>
        <li class="rounded-2xl p-2
                    bg-linear-to-tl from-primary-shade-2 to-primary-shade
                    inset-shadow-none hover:inset-shadow-sm hover:inset-shadow-black
                    hover:text-shadow-theme-white hover:text-shadow-md">
          <a
            href="https://linkedin.com/in/SrVariable"
            target="_blank"
            rel="noopener noreferrer"
            class="flex justify-center gap-2 text-theme-white"
          >
            <LinkedIn />
            LinkedIn
          </a>
        </li>
        <li class="col-span-full xsm:col-auto rounded-2xl p-2
                    bg-linear-to-tl from-primary-shade-2 to-primary-shade
                    inset-shadow-none hover:inset-shadow-sm hover:inset-shadow-black
                    hover:text-shadow-white hover:text-shadow-sm">
          <a
            href="mailto:rojohnibana@gmail.com"
            class="flex justify-center gap-2 text-theme-white">
            <Email />
            Contáctame
          </a>
        </li>
      </ul>
    </nav>
  </div>
</section>
