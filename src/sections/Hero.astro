---
import { LINKS } from "../const/link.ts"
---

<section
  id="hero"
  class="mx-auto mt-32 mb-20 flex w-full max-w-4xl scroll-mt-24
         flex-col items-center gap-8 px-4
         md:mb-48 md:flex-row md:items-center md:gap-12"
>
  <div class="group size-30 shrink-0 [perspective:1000px] md:size-44">
    <div
      class="relative size-full transition-transform duration-500 ease-out
             [transform-style:preserve-3d] motion-reduce:duration-0
             group-hover:[transform:rotateY(180deg)]"
    >
      <img
        src="/images/chopper.webp"
        alt="An image of Chopper sitting in V logo"
        class="absolute inset-0 size-full rounded-full object-cover
               ring-2
               [backface-visibility:hidden] [-webkit-backface-visibility:hidden]"
      />
      <img
        src="/images/me.webp"
        alt="The face of SrVariable"
        aria-hidden="true"
        class="absolute inset-0 size-full rounded-full bg-surface object-cover
               ring-2
               [backface-visibility:hidden] [-webkit-backface-visibility:hidden]
               [transform:rotateY(180deg)]"
      />
    </div>
  </div>
  <div class="flex flex-col items-center text-center md:items-start md:text-left">
    <h1 class="mb-4 text-4xl font-bold tracking-tight text-balance sm:text-5xl">
      Yow, soy <span class="text-accent-soft">SrVariable</span> 👋
    </h1>
    <p class="mb-6 border-l-2 border-accent-deep/60 pl-4 text-base text-fg-muted italic md:text-lg">
      Sé más de lo que creo y menos de lo que piensas
    </p>
    <p class="mb-8 max-w-xl text-base leading-relaxed text-fg-muted text-pretty">
      +3 años de experiencia. <strong class="font-semibold text-fg">Desarrollador de Software </strong>
      de Málaga, España. Especializado en <strong class="font-semibold text-fg">resolver problemas </strong>
      y buscando mi siguiente reto.
    </p>
    <nav class="w-full">
      <ul class="grid grid-cols-2 gap-3 xsm:grid-cols-3">
        {
          LINKS.map(({ label, href, icon: Icon, wide }) => (
            <li class={wide ? "col-span-full xsm:col-auto" : ""}>
              <a
                href={href}
                target={href.startsWith("mailto:") ? undefined : "_blank"}
                rel={href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                class="flex items-center justify-center gap-2 rounded-lg
                       border border-line bg-surface/50 px-4 py-2.5
                       text-sm text-fg-muted transition-colors duration-200
                       hover:border-accent-deep hover:bg-surface-hover hover:text-fg"
              >
                <Icon styles="size-5" />
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>
