---
import Button from "../components/Button.astro";

const { project } = Astro.props;
const { name, description, image, technologies, source, url } = project;
---

<article
  class="group grid gap-6 rounded-xl border border-line bg-surface/40 p-6
         transition-colors duration-200 hover:border-line-strong hover:bg-surface
         md:grid-cols-2 md:gap-8"
>
  {
    image && (
      <div class="overflow-hidden rounded-lg border border-line self-center">
        <img
          class="w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
          src={image}
          alt={`Screenshot of ${name}`}
          loading="lazy"
        />
      </div>
    )
  }
  <div class="flex flex-col">
    <h3 class="text-xl font-semibold text-fg">{name}</h3>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        technologies.map((tech: string) => (
          <li class="rounded-full border border-accent-deep bg-ink-soft px-2.5 py-0.5 text-xs text-fg">
            {tech}
          </li>
        ))
      }
    </ul>
    <p class="mt-4 leading-relaxed text-fg-muted text-pretty">{description}</p>
    {
      (source || url) && (
        <footer class="mt-6 grid grid-cols-2 gap-3 pt-2 md:mt-auto">
          {source && (
            url
              ? <Button url={source}>Código</Button>
              : <Button extraClass="col-span-full" url={source}>Código</Button>
          )}
          {url && <Button url={url}>Demo</Button>}
        </footer>
      )
    }
  </div>
</article>
