---
interface Props {
  extraClass?: string;
	url?: string;
}

const { extraClass, url } = Astro.props;
---
<a
  class=`${extraClass}
          p-2 rounded-2xl
          text-center text-theme-white hover:text-shadow-white hover:text-shadow-sm
          bg-linear-to-tl from-primary-shade-2 to-primary-shade
          inset-shadow-none hover:inset-shadow-sm hover:inset-shadow-black`
  href={url}
  target="_blank"
  rel="noopener noreferrer"
>
<slot />
</a>
