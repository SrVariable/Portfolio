---
interface Props {
  extraClass?: string;
  url?: string;
}

const { extraClass = "", url } = Astro.props;
---

<a
  class={`${extraClass} rounded-lg border border-line bg-surface/50 px-4 py-2
          text-center text-sm text-fg-muted transition-colors duration-200
          hover:border-accent-deep hover:bg-surface-hover hover:text-fg`}
  href={url}
  target="_blank"
  rel="noopener noreferrer"
>
  <slot />
</a>
