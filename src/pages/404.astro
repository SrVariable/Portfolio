---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada · SrVariable">
  <section
    class="flex min-h-[70vh] flex-col items-center justify-center px-4 text-center"
  >
    <p class="mb-4 text-7xl font-bold tracking-tight text-accent">404</p>
    <h1 class="mb-4 text-3xl font-semibold tracking-tight text-fg">
      Página no encontrada
    </h1>
    <p class="mb-8 max-w-sm text-base text-fg-muted text-pretty">
      ¿Te has perdido? No te preocupes, puedes volver al principio.
    </p>
    <a
      href="/"
      class="rounded-lg border border-line bg-surface/50 px-6 py-2.5 text-sm
             text-fg-muted transition-colors duration-200
             hover:border-accent-deep hover:bg-surface-hover hover:text-fg"
    >
      Ir al inicio
    </a>
  </section>
</Layout>
